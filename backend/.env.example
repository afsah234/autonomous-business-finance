# Autonomous Business Finance Platform (ABFP) - Backend Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String (Prisma ORM)
# Do NOT commit real credentials. Configure according to your local or cloud PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abfp_dev?schema=public"

# Security & CORS
CORS_ORIGIN="http://localhost:5173"
